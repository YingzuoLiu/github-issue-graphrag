# Provider-neutral local/CI Compose inputs. Copy to .env.deploy; do not commit it.
GITHUB_REPO=owner/name
PUBLIC_HTTP_PORT=8080
SITE_ADDRESS=:8080

# Durable host paths. Provider-specific volume paths are selected in PR B.
REPO_DATA_HOST=./deploy-data/repos
RADAR_ANALYTICS_HOST=./deploy-data/analytics
BACKUP_DATA_HOST=./backups

# Secret file paths contain values. The files themselves must not be committed.
GITHUB_TOKEN_FILE_HOST=./secrets/github_token
GITHUB_WEBHOOK_SECRET_FILE_HOST=./secrets/github_webhook_secret
