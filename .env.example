# Copy this file to .env and fill in local values.
# Never commit .env.

# M4 live extraction uses OpenRouter. Keep mock for deterministic/offline work.
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-3.1-flash-lite

# Cross-repository UTC/day and calendar-month hard caps. Set any global cap to
# 0 after a one-time acceptance run to defer new model calls without losing work.
LLM_DAILY_CALLS=250
LLM_DAILY_INPUT_TOKENS=300000
LLM_DAILY_OUTPUT_TOKENS=125000
LLM_MONTHLY_COST_USD=3

# First semantic bootstrap is admitted inside (never in addition to) global caps.
LLM_BOOTSTRAP_CALLS=200
LLM_BOOTSTRAP_INPUT_TOKENS=250000
LLM_BOOTSTRAP_OUTPUT_TOKENS=100000

# One resumable batch. These are scheduling limits, not document lifetime limits.
LLM_BATCH_CALLS=12
LLM_BATCH_INPUT_TOKENS=20000
LLM_BATCH_OUTPUT_TOKENS=10000
LLM_MAX_OUTPUT_TOKENS_PER_CALL=800

# Cost reservation guard for the pinned model. Update deliberately if the
# OpenRouter model page changes; provider-reported actual cost is retained.
LLM_INPUT_PRICE_PER_MILLION_USD=0.25
LLM_OUTPUT_PRICE_PER_MILLION_USD=1.50
LLM_COST_SAFETY_MULTIPLIER=2

# Embedding provider options: sentence-transformers, mock
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

VECTOR_DB_PATH=data/processed/qdrant
VECTOR_COLLECTION=issue_graphrag

# Optional GitHub token for higher rate limits when fetching issues.
GITHUB_TOKEN=

# Configured product repositories. Each receives an independent directory and worker lane.
GITHUB_REPOS=owner/name,other/repository

# External-repository reconciliation cadence. The M5 default is 15 minutes;
# GitHub's X-Poll-Interval or a rate-limit reset can extend the next attempt.
GITHUB_SYNC_INTERVAL_SECONDS=900

# Real-time webhook ingestion. One receiver/worker process still owns one repository lane.
GITHUB_WEBHOOK_REPO=owner/name
GITHUB_WEBHOOK_SECRET=

# Local paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPO_DATA_DIR=data/repos
